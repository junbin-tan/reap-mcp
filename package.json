{
  "name": "reap-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable, approval-gated MCP commerce for Reap sandbox and explicit mock simulation.",
  "engines": {
    "node": ">=22.16.0 <23 || >=24 <25"
  },
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "dev": "tsx src/http-main.ts",
    "dev:stdio": "tsx src/stdio-main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http-main.js",
    "start:stdio": "node dist/stdio-main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit test/contract",
    "test:db": "vitest run test/integration --maxWorkers=1 --no-file-parallelism",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx src/migrate.ts",
    "sandbox:check": "tsx scripts/sandbox-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "jose": "6.1.3",
    "lossless-json": "4.3.1",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
